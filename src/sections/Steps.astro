---
import Button from "../components/Button.astro";
type Translations = typeof import("../i18n/en").default;
type Content = Translations["main"]["steps"];
interface Props {
  content: Content;
}
const { content } = Astro.props as Props;
---
<section class="w-full flex justify-center items-center bg-primary" id="about">
  <div class="container-full grid grid-cols-1 md:grid-cols-3 flex-col justify-center items-center py-16 md:py-12 gap-8 md:gap-[112px]  text-white">
    {
      content.map((item, index) => ( 
        <div class='flex flex-col justify-center items-center gap-3 text-center fade-up-a' style={`animation-delay: ${index * 100}ms`}>
          <div class='flex justify-center items-center gap-2'>
            <img src={`/images/step-${index+1}.svg`} width="24" height="24" decoding="async" loading="lazy"/>
            <h3 class='subtitle-sm text-white'>{item.title}</h3>
          </div>
          <p class='paragraph'>{item.description}</p>
        </div>
      ))
    }
    
  </div>
</section>
