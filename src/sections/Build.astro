---
import Button from "../components/Button.astro";
type Translations = typeof import("../i18n/en").default;
type Content = Translations["main"]["build"];
interface Props {
  content: Content;
}
const { content } = Astro.props as Props;
---
<section class="w-full flex justify-center items-center bg-[#F5F5F5]" >
  <div class="container-full flex flex-col justify-center items-start gap-8 md:gap-10 py-12 md:py-25">
    <div class='flex flex-col justify-center items-center md:items-start gap-4 w-full'>
      <p class="text-[14px] font-bold leading-[100%] tracking-[3px] text-secondary uppercase fade-up-a">{content.tag}</p> 
      <h2 class='subtitle text-primary capitalize text-center fade-up-a'>{content.title}</h2>
    </div>
    <div class='w-full grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6'>
      {
        content.items.map((item,index)=>( 
          <div class='flex flex-col justify-start items-center bg-white rounded-lg fade-up-a shadow-card overflow-hidden' style={`animation-delay: ${index * 100}ms`}>
            <div class="w-full h-auto relative overflow-hidden aspect-398/245 md:aspect-410/245">
              <img src={`/images/${item.image}.webp`} alt={item.title} class="w-full h-full absolute inset-0 object-cover object-center z-0" width="800" height="450" decoding="async" loading="lazy"/>
            </div>
            <div class='w-full flex justify-between items-center gap-4 p-6'>
              <div class='flex flex-col justify-center items-start gap-3 max-w-[250px]'>
                <h3 class='subtitle-sm text-primary capitalize'>{item.title}</h3>
                <p class='paragraph text-primary'>{item.description}</p>
              </div>
              <img src='/images/arrow.svg' alt='Arrow' class='w-8 h-8' decoding="async" loading="lazy"/>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>