---
import FormContact from "../components/FormContact.astro";

type Translations = typeof import("../i18n/en").default;
type Content = Translations["main"]["contact"];
interface Props {
  content: Content;
}
const { content } = Astro.props as Props;
---
<section class="w-full flex justify-center items-center relative" id="contact">
  <img src='/images/backForm.webp' alt='Contact Background' class="absolute inset-0 object-cover w-full h-full z-0" width="1440" height="622"/>
  <!-- 1. Cambiado 'justify-center items-between' por 'justify-between' -->
  <div class="container-full flex flex-col lg:flex-row justify-center items-center md:items-stretch gap-4 md:gap-6 py-12 md:py-25 z-10 relative">
    <div class='flex flex-col justify-center items-center lg:items-start gap-4 px-8 py-10 lg:py-6 bg-white rounded-lg fade-up-a w-full lg:w-auto'>
      <p class='text-[14px] font-bold leading-[120%] uppercase tracking-[3px] text-primary fade-up-a' style="animation-delay: 300ms">{content.tag}</p>
      <h2 set:html={content.title} class='subtitle text-primary text-center lg:text-left fade-up-a' style="animation-delay: 400ms"></h2>
      <p class="paragraph text-primary fade-up-a" style="animation-delay: 500ms">{content.description}</p>
      <div class='flex justify-start items-center gap-2 fade-up-a' style="animation-delay: 600ms">
        <img src='/images/phone.svg' alt='Phone Icon' width="40" height="40" decoding="async" loading="lazy"/>
        <a href="tel:+14078012729" class='text-[40px] font-bold leading-[120%] text-primary hover:text-secondary transition-all duration-300 ease-in-out'>407-801-2729</a>
      </div>
      <p class="paragraph text-primary fade-up-a" style="animation-delay: 600ms">{content.city}</p>
    </div>

    <div class="bg-white flex flex-col justify-center items-start  px-4 py-6 lg:p-6 rounded-lg w-full lg:w-[60%]  fade-up-a gap-2 max-w-none lg:max-w-[628px]">
      {/* */}
      <FormContact />
      <p class='text-[12px] font-normal leading-[120%] text-primary text-left fade-up-a' style="animation-delay:300ms">{content.formDescription}</p>
    </div>
  </div>
  
</section>