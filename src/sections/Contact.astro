---
type Translations = typeof import("../i18n/en").default;
type Content = Translations["main"]["formContact"];
interface Props {
  content: Content;
}
const { content } = Astro.props as Props;
---
<section class="container-full flex flex-col md:flex-row justify-center items-center md:items-stretch gap-8 md:gap-6 py-16 md:py-20" id="contact">
  <!-- 1. Cambiado 'justify-center items-between' por 'justify-between' -->
  <div class='w-full md:w-1/2 flex flex-col justify-between gap-8'>
    <div class='flex flex-col justify-center items-start gap-8 text-primary'>
      <h2 class='subtitle' set:html={content.title}></h2>
      <p class='paragraph'>{content.description}</p>
    </div>
    
    <div class='w-full relative overflow-hidden rounded-2xl aspect-628/429'>
      <img src='/images/form-contact.webp' alt='Request a project consultation with Foundation One Construction' width="1248" height="848" decoding="async" loading="lazy" class='w-full h-full object-cover absolute inset-0' />
    </div>
  </div>

  <div class="bg-[#F2F4F6] flex flex-col justify-center items-start p-8 rounded-2xl gap-10 w-full md:w-1/2 h-[80vh]">
    <p>{content.information}</p>
  </div>
</section>