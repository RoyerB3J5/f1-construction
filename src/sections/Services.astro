---
type Translations = typeof import("../i18n/en").default;
type Content = Translations["main"]["services"];
interface Props {
  content: Content;
}
const { content } = Astro.props as Props;
---
<section class="w-full flex justify-center items-center bg-white">
  <div class='container-full grid grid-cols-2 lg:grid-cols-4 items-stretch gap-0 py-10'>
    {
      content.map((item,index)=>( 
        <div
          class={`relative flex min-w-0 flex-col justify-center lg:justify-start items-center lg:items-start gap-3 text-primary fade-up-a ${
            index % 2 === 1
              ? "after:absolute after:left-0 after:border-l after:border-[#01204E4D] pl-3"
              : "pr-3"
          } ${index >= 2 ? "border-t border-[#01204E4D] pt-[18px] after:top-[18px] after:bottom-0" : "pb-[18px] after:top-0 after:bottom-[18px]"} ${
            index > 0 ? "lg:border-l lg:border-t-0 lg:border-[#01204E4D] lg:pl-6" : ""
          } lg:after:hidden lg:pb-0 lg:pt-0 ${index < content.length - 1 ? "lg:pr-6" : ""}`}
          style={`animation-delay: ${index * 100}ms`}
        >
          <img src={`/images/services-${index+1}.svg`} alt={item.title} class='w-6 h-6' decoding='async' loading="lazy"/>
          <h3 class='text-[16px] lg:text-[14px] font-bold leading-[150%] lg:leading-[100%] tracking-[3px] text-center lg:text-left'>{item.title}</h3>
          <p class='paragraph hidden md:block text-center'>{item.description}</p>
        </div>
      ))
    }
  </div>
</section>
