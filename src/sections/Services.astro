---
import Button from "../components/Button.astro";
type Translations = typeof import("../i18n/en").default;
type Content = Translations["main"]["services"];
interface Props {
  content: Content;
}
const { content } = Astro.props as Props;
---
<section class="w-full flex justify-center items-center" id="services" aria-label="Services">
  <div class="container-full flex flex-col justify-center items-center gap-8 md:gap-14 py-16 md:py-20">
    <div class='flex flex-col justify-center items-start md:items-center gap-8'> 
      <h2 class='subtitle text-primary capitalize text-center'>{content.title}</h2>
      <p set:html={content.description} class="text-start md:text-center text-primary paragraph"></p>
    </div>
    <div class='w-full grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6'>
      {
        content.items.map((item)=>( 
          <div class='flex flex-col justify-start items-center p-4 md:p-6 gap-6 border-[1.5px] border-[#DDDDDD] rounded-2xl'>
            <div class="w-full h-auto relative overflow-hidden rounded-2xl flex justify-start items-start p-4 aspect-366/120 md:aspect-363/204">
              <img src={`/images/${item.image}.webp`} alt={item.title} class="w-full h-full absolute inset-0 object-cover object-center z-0" width="800" height="450" decoding="async" loading="lazy"/>
              <img src={`/images/${item.icon}.svg`} alt={item.title} class='w-12 h-12 relative z-10' width="48" height="48" decoding="async" loading="lazy"/>
            </div>
            <div class='w-full flex flex-col justify-center items-start gap-4'>
              <h3 class='subtitle-sm text-primary capitalize'>{item.title}</h3>
              <p class='paragraph text-primary'>{item.description}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>