---
import Button from "../components/Button.astro";
type Translations = typeof import("../i18n/en").default;
type Content = Translations["main"]["goal"];
interface Props {
  content: Content;
}
const { content } = Astro.props as Props;
---
<section class="container-full flex flex-col justify-center items-center py-25 gap-8">
  <p class="text-[18px] font-medium leading-[100%] text-primary">{content.tag}</p>
  <h2 class="subtitle text-primary text-center" set:html={content.title}></h2>
</section>