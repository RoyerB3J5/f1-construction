---
import Button from "../components/Button.astro";
type Translations = typeof import("../i18n/en").default;
type Content = Translations["main"]["approach"];
interface Props {
  content: Content;
}
const { content } = Astro.props as Props;
---
<section class="w-full flex justify-center items-center relative h-[600px]">
  <img src='/images/back-approach.webp' class="absolute inset-0 object-cover w-full h-full z-0" decoding="async" loading="lazy"/>
  <div class="relative z-10 container-full flex justify-end items-center py-25">
    <div class="bg-primary px-8 py-12 flex flex-col justify-center items-center gap-6 rounded-lg">
      <div class='flex flex-col justify-center items-center gap-4'>
        <p class='text-[14px] font-bold leading-[120%] uppercase tracking-[3px] text-white fade-up-a'>{content.tag}</p>
        <h2 class='subtitle text-secondary text-center fade-up-a' set:html={content.title}></h2>
      </div>
      <p class='paragraph text-white fade-up-a text-center max-w-[68%] md:max-w-none'>{content.description}</p>
      <Button
          text={content.button.label}
          href={content.button.href}
          textClass="capitalized"
          extraBtnClass="flex bg-secondary border-secondary fade-up-a"
          colorText="text-white"
          width="w-full"          
        />
    </div>
  </div>
</section>