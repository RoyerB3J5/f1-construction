---
import en from "../../i18n/en";
import es from "../../i18n/es";
import Layout from "../../layouts/Layout.astro";
import Approach from "../../sections/Approach.astro";
import Build from "../../sections/Build.astro";
import Contact from "../../sections/Contact.astro";
import Hero from "../../sections/Hero.astro";
import Services from "../../sections/Services.astro";
import Steps from "../../sections/Steps.astro";


import type { Language } from "../../types/language.type";

export function getStaticPaths() {
  return [{ params: { lang: "es" } }, { params: { lang: "en" } }];
}

export const defaultRedirect = "/en";

const lang = Astro.params.lang as Language;
const translations = { es, en };
const t = translations[lang];
const seo = t.seo.main;

---

<Layout
  lang={lang}
  t={t}
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  canonicalPath="/"
>
  <Hero content={t.main.hero} />
  <Services content={t.main.services} />
  <Build content={t.main.build} />
  <Approach content={t.main.approach} />
  <Steps content={t.main.steps} />
  <Contact content={t.main.contact} />
</Layout>
