---
import en from "../../i18n/en";
import es from "../../i18n/es";
import Layout from "../../layouts/Layout.astro";
import Contact from "../../sections/Contact.astro";
import Faqs from "../../sections/Faqs.astro";
import Goal from "../../sections/Goal.astro";
import Hero from "../../sections/Hero.astro";
import Services from "../../sections/Services.astro";
import Steps from "../../sections/Steps.astro";
import Strategic from "../../sections/Strategic.astro";

import type { Language } from "../../types/language.type";

export function getStaticPaths() {
  return [{ params: { lang: "es" } }, { params: { lang: "en" } }];
}

export const defaultRedirect = "/en";

const lang = Astro.params.lang as Language;
const translations = { es, en };
const t = translations[lang];
const seo = t.seo.main;

// FAQ rich-result schema built from the page content (read-only use of main).
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: t.main.faqs.map((item) => ({
    "@type": "Question",
    name: item.question.replace(/^\d+\.\s*/, ""),
    acceptedAnswer: { "@type": "Answer", text: item.answer },
  })),
};
---

<Layout
  lang={lang}
  t={t}
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  canonicalPath="/"
  structuredData={faqSchema}
>
  <Hero content={t.main.hero} />
  <Services content={t.main.services} />
  <Strategic content={t.main.strategic} />
  <Goal content={t.main.goal} />
  <Steps content={t.main.steps} />
  <Contact content={t.main.formContact} />
  <Faqs content={t.main.faqs} />
</Layout>
