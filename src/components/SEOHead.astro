---
import {
  facebookLink,
  instagramLink,
  emailAddress,
  phoneNumber,
} from "../constants/info";

export interface Props {
  lang?: string;
  title?: string;
  description?: string;
  keywords?: string;
  image?: string;
  canonicalPath?: string;
  noindex?: boolean;
  type?: string;
  structuredData?: object | object[];
}

// No public domain yet: canonical / OG URLs stay relative until one exists.
const SITE_URL = "";
const SITE_NAME = "Foundation One Construction";

const {
  lang = "en",
  title = "F1 Construction | Restoration & Capital Improvements in Central Florida",
  description = "Foundation One Construction partners with HOA boards and property owners to deliver restoration and capital improvement solutions designed to preserve value and strengthen communities in Central Florida.",
  keywords = "construction, restoration, capital improvement, HOA restoration, condominium restoration, Central Florida contractor",
  image = "/images/portada.jpg",
  canonicalPath = "",
  noindex = false,
  type = "website",
  structuredData,
} = Astro.props;

// Normalize path format
const cleanPath = canonicalPath.startsWith("/")
  ? canonicalPath
  : `/${canonicalPath}`;
const formattedPath = cleanPath === "/" ? "" : cleanPath;

const hasSiteUrl =
  SITE_URL.startsWith("http://") || SITE_URL.startsWith("https://");
const base = hasSiteUrl ? SITE_URL : "";

// Formatted URLs for SEO & Hreflang (relative until a domain exists)
const currentCanonical = `${base}/${lang}${formattedPath}`;
const enUrl = `${base}/en${formattedPath}`;
const esUrl = `${base}/es${formattedPath}`;
const defaultUrl = enUrl;

// Image URL (absolute once a domain exists)
const absoluteImage =
  hasSiteUrl && !image.startsWith("http")
    ? `${SITE_URL}${image.startsWith("/") ? "" : "/"}${image}`
    : image;

// A value is a placeholder when empty, "#" or an obvious mask like "(XXX)".
const isPlaceholder = (value: unknown): boolean => {
  if (typeof value !== "string") return true;
  const v = value.trim();
  return v === "" || v === "#" || v.includes("XXX");
};

// Base GeneralContractor / Organization Schema (no phone, email or socials yet)
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "GeneralContractor",
  "@id": `${base}/#organization`,
  name: SITE_NAME,
  legalName: SITE_NAME,
  ...(hasSiteUrl ? { url: SITE_URL } : {}),
  logo: `${base}/favicon.svg`,
  image: absoluteImage,
  description: description,
  ...(!isPlaceholder(phoneNumber) ? { telephone: phoneNumber } : {}),
  ...(!isPlaceholder(emailAddress) ? { email: emailAddress } : {}),
  address: {
    "@type": "PostalAddress",
    addressLocality: "Orlando",
    addressRegion: "FL",
    addressCountry: "US",
  },
  areaServed: {
    "@type": "AdministrativeArea",
    name: "Central Florida",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: 28.5383,
    longitude: -81.3792,
  },
  sameAs: [facebookLink, instagramLink].filter(
    (link): link is string =>
      typeof link === "string" && link.startsWith("http"),
  ),
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${base}/#website`,
  url: hasSiteUrl ? SITE_URL : currentCanonical,
  name: SITE_NAME,
  publisher: {
    "@id": `${base}/#organization`,
  },
  inLanguage: [
    { "@type": "Language", name: "English", alternateName: "en" },
    { "@type": "Language", name: "Spanish", alternateName: "es" },
  ],
};

// Custom schemas passed via props
const customSchemas = structuredData
  ? Array.isArray(structuredData)
    ? structuredData
    : [structuredData]
  : [];

const allSchemas = [organizationSchema, websiteSchema, ...customSchemas];
---

<!-- Basic Meta Tags -->
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<title>{title}</title>
<meta name="description" content={description} />
<meta name="keywords" content={keywords} />
<meta name="author" content={SITE_NAME} />
<meta
  name="robots"
  content={noindex
    ? "noindex, nofollow"
    : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"}
/>

<!-- Location Meta Tags -->
<meta name="geo.region" content="US-FL" />
<meta name="geo.placename" content="Orlando" />
<meta name="geo.position" content="28.5383;-81.3792" />
<meta name="ICBM" content="28.5383, -81.3792" />

<!-- Links & Preconnect -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="preconnect" href="https://link.inkshapecrm.com" />
<link rel="dns-prefetch" href="https://link.inkshapecrm.com" />
<link rel="icon" type="image/x-icon" href="/favicon.ico" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

<!-- Canonical & Hreflang -->
<link rel="canonical" href={currentCanonical} />
<link rel="alternate" hreflang="en" href={enUrl} />
<link rel="alternate" hreflang="es" href={esUrl} />
<link rel="alternate" hreflang="x-default" href={defaultUrl} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={currentCanonical} />
<meta property="og:image" content={absoluteImage} />
<meta property="og:locale" content={lang === "es" ? "es_US" : "en_US"} />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={absoluteImage} />

<meta name="generator" content={Astro.generator} />

<!-- Structured Data / JSON-LD -->
{
  allSchemas.map((schema) => (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))
}
