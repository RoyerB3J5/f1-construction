<!-- Chatbot lazy-load: sin placeholder, solo carga diferida del widget real -->
<noscript>
  <a href="/connect/" class="chatbot-noscript">Contacta con nosotros</a>
</noscript>

<style>
  /* Mantenemos el z-index original para evitar solapamientos */
  :global(#chat-widget-container),
  :global(.lc_chat-widget),
  :global(div[id*="chat-widget"]) {
    z-index: 40 !important;
  }

  .chatbot-noscript {
    position: fixed;
    right: 20px;
    bottom: 20px;
    background: #ef670e;
    color: #fff;
    padding: 8px 12px;
    border-radius: 8px;
    text-decoration: none;
  }
</style>

<script>
  (() => {
    const WIDGET_ID = "6ab58640fad6c0284b9d3b01";
    const RES_URL = "https://widgets.leadconnectorhq.com/chat-widget/loader.js";
    const SRC = "https://widgets.leadconnectorhq.com/loader.js";
    let loaded = false;

    function insertScript() {
      if (loaded) return;
      loaded = true;
      const s = document.createElement("script");
      s.src = SRC;
      s.setAttribute("data-resources-url", RES_URL);
      s.setAttribute("data-widget-id", WIDGET_ID);
      s.async = true;
      document.body.appendChild(s);
      cleanup();
    }

    function cleanup() {
      window.removeEventListener("pointerdown", insertScript);
      window.removeEventListener("keydown", insertScript);
      window.removeEventListener("scroll", onScroll);
    }

    function onScroll() {
      // En móvil espera un poco de scroll, en escritorio carga al primer scroll
      if (window.innerWidth <= 640) {
        const y = window.pageYOffset || document.documentElement.scrollTop;
        if (y > 200) insertScript();
      } else {
        insertScript();
      }
    }

    // Interacción = carga inmediata (una sola vez)
    window.addEventListener("pointerdown", insertScript, { once: true });
    window.addEventListener("keydown", insertScript, { once: true });
    window.addEventListener("scroll", onScroll, { passive: true });

    // Idle = carga diferida eficiente (no bloquea LCP/INP)
    const idleLoad = () => insertScript();
    if ("requestIdleCallback" in window) {
      (window as any).requestIdleCallback(idleLoad, { timeout: 4000 });
    } else {
      setTimeout(idleLoad, 3000);
    }
  })();
</script>
